<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Schlieren.UI.ViewModels"
        xmlns:views="using:Schlieren.UI.Views"
        x:Class="Schlieren.UI.Views.MainWindow"
        x:Name="root"
        x:DataType="vm:WorkbenchViewModel"
        Title="SCHLIEREN"
        Icon="/Assets/schlieren-icon.png"
        Width="1440" Height="900"
        WindowStartupLocation="CenterScreen"
        Background="#060607"
        FontFamily="JetBrains Mono, Cascadia Code, Consolas, monospace"
        FontSize="13">

  <Window.Styles>

    <!-- Monospace data text -->
    <Style Selector="TextBlock.data">
      <Setter Property="FontFamily" Value="JetBrains Mono, Cascadia Code, Consolas, monospace"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#E4E0DC"/>
    </Style>

    <!-- Chrome labels -->
    <Style Selector="TextBlock.label">
      <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif"/>
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#454B54"/>
      <Setter Property="LetterSpacing" Value="1.5"/>
    </Style>

    <!-- Nav tab base -->
    <Style Selector="Border.nav-tab">
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="BorderThickness" Value="0,0,0,2"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style Selector="Border.nav-tab TextBlock">
      <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="#6A7280"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.nav-tab:pointerover">
      <Setter Property="BorderBrush" Value="#3A3E44"/>
    </Style>

    <Style Selector="Border.nav-tab:pointerover TextBlock">
      <Setter Property="Foreground" Value="#A0A8B4"/>
    </Style>

    <Style Selector="Border.nav-tab.active">
      <Setter Property="BorderBrush" Value="#E4E0DC"/>
    </Style>

    <Style Selector="Border.nav-tab.active TextBlock">
      <Setter Property="Foreground" Value="#E4E0DC"/>
    </Style>

    <!-- Pill buttons -->
    <Style Selector="Border.pill">
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#2A2D32"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Border.pill TextBlock">
      <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif"/>
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#6A7280"/>
    </Style>

    <Style Selector="Border.pill:pointerover">
      <Setter Property="BorderBrush" Value="#3A3E44"/>
    </Style>

    <Style Selector="Border.pill:pointerover TextBlock">
      <Setter Property="Foreground" Value="#A0A8B4"/>
    </Style>

    <!-- Pane section titles -->
    <Style Selector="TextBlock.pane-title">
      <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif"/>
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="LetterSpacing" Value="1.8"/>
      <Setter Property="Foreground" Value="#454B54"/>
    </Style>

    <!-- Existing compat styles -->
    <Style Selector="TextBlock.header">
      <Setter Property="Foreground" Value="{DynamicResource Schlieren.AccentAlt}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style Selector="TextBlock.code">
      <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource Schlieren.TextPrimary}"/>
    </Style>
    <Style Selector="TextBlock.linenumber">
      <Setter Property="Foreground" Value="{DynamicResource Schlieren.AccentAlt}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace"/>
    </Style>
    <Style Selector="Border.activeLine">
      <Setter Property="Background" Value="{DynamicResource Schlieren.ActiveLineBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Schlieren.AccentAlt}"/>
      <Setter Property="BorderThickness" Value="2,0,0,0"/>
    </Style>
    <Style Selector="Border.vulnerableLine">
      <Setter Property="Background" Value="{DynamicResource Schlieren.VulnerableLineBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Schlieren.Alert}"/>
      <Setter Property="BorderThickness" Value="2,0,0,0"/>
    </Style>
    <Style Selector="Button.brand-primary">
      <Setter Property="Background" Value="{DynamicResource Schlieren.Accent}"/>
      <Setter Property="Foreground" Value="{DynamicResource Schlieren.TextPrimary}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="CornerRadius" Value="3"/>
    </Style>

  </Window.Styles>

  <LayoutTransformControl Name="ZoomHost">
  <!-- ROOT GRID: menu / top-nav / case-bar / bytecode-bar / workspace / status-bar -->
  <Grid RowDefinitions="26,34,28,Auto,*,24" Background="#060607"
        Name="RootGrid">
    <!-- SLOT 0: Menu -->
    <Menu Grid.Row="0" Background="#0B0C0D"
          BorderBrush="#2A2D32" BorderThickness="0,0,0,1">
      <MenuItem Header="_File" FontSize="12" FontFamily="Inter, Segoe UI, sans-serif">
        <MenuItem Header="Open Contract File..."        Click="OnOpenFileClick"     InputGesture="Ctrl+O"/>
        <MenuItem Header="Load Fixture or Contract..."  Click="OnLoadPrestateClick" InputGesture="Ctrl+Shift+P"/>
        <MenuItem Header="Load Pre-state JSON..."       Click="OnLoadPrestateClick"/>
        <MenuItem Header="Open Project Folder..."       Click="OnOpenFolderClick"   InputGesture="Ctrl+Shift+O"/>
        <MenuItem Header="Reset Workbench"              Click="OnResetClick"        InputGesture="Ctrl+Shift+R"/>
        <Separator/>
        <MenuItem Header="Export Security Audit Report (.md)..." Click="OnExportReportClick"/>
        <Separator/>
        <MenuItem Header="Exit" Click="OnExitClick" InputGesture="Alt+F4"/>
      </MenuItem>
      <MenuItem Header="_EVM Engine" FontSize="12" FontFamily="Inter, Segoe UI, sans-serif">
        <MenuItem Header="Run Bytecode (Live EVM)"     Command="{Binding RunBytecodeCommand}"    InputGesture="F5"/>
      </MenuItem>
      <MenuItem Header="_View" FontSize="12" FontFamily="Inter, Segoe UI, sans-serif" Name="ViewMenuRoot">
        <MenuItem Header="Workbench"   Click="OnWorkbenchViewClick" InputGesture="Ctrl+1"/>
        <MenuItem Header="Conformance" Click="OnConformanceMenuClick" InputGesture="Ctrl+2"/>
        <MenuItem Header="Harvest"     Click="OnHarvestMenuClick"   InputGesture="Ctrl+3"/>
        <Separator/>
        <MenuItem Header="Call Graph"  Command="{Binding ShowCallGraphCommand}"/>
        <MenuItem Header="Source"      Command="{Binding ShowSourceCommand}"/>
        <Separator/>
        <MenuItem Header="Block Context"  Command="{Binding ToggleBlockContextCommand}"/>
        <MenuItem Header="TX Parameters"  Command="{Binding ToggleTxParamsCommand}"/>
        <MenuItem Header="Pre-state"      Command="{Binding TogglePrestateCommand}"/>
        <Separator/>
        <MenuItem Header="Appearance" Name="AppearanceMenu"/>
      </MenuItem>
      <MenuItem Header="_Tools" FontSize="12" FontFamily="Inter, Segoe UI, sans-serif">
        <MenuItem Header="Show Call Topology" Command="{Binding ShowCallGraphCommand}"/>
        <MenuItem Header="Show Source"        Command="{Binding ShowSourceCommand}"/>
        <Separator/>
        <MenuItem Header="Toggle OpSec Lockout" Command="{Binding ToggleOpSecCommand}"/>
        <Separator/>
        <MenuItem Header="Open n8n (localhost:5678)" Click="OnOpenN8nClick"/>
        <MenuItem Header="Open Corpus Folder"        Click="OnOpenCorpusFolderClick"/>
        <Separator/>
        <MenuItem Header="Export Audit Report (.md)..." Click="OnExportReportClick"/>
        <MenuItem Header="Export Trace JSON..."         Click="OnExportTraceClick"/>
      </MenuItem>
      <MenuItem Header="_Help" FontSize="12" FontFamily="Inter, Segoe UI, sans-serif">
        <MenuItem Header="Keyboard Shortcuts">
          <MenuItem Header="F5  - Run bytecode"              IsEnabled="False"/>
          <MenuItem Header="F10 - Step forward"              IsEnabled="False"/>
          <MenuItem Header="F11 - Step back"                 IsEnabled="False"/>
          <MenuItem Header="Space - Play / Pause"            IsEnabled="False"/>
          <MenuItem Header="Home / End - Jump to start/end"  IsEnabled="False"/>
          <MenuItem Header="Ctrl+1/2/3 - Switch views"       IsEnabled="False"/>
          <MenuItem Header="Ctrl+O - Open file"              IsEnabled="False"/>
          <MenuItem Header="Ctrl+Shift+R - Reset workbench"  IsEnabled="False"/>
        </MenuItem>
        <Separator/>
        <MenuItem Header="About Schlieren" Click="OnAboutClick"/>
      </MenuItem>
    </Menu>
    <!-- SLOT 1: Top nav -->
    <Border Grid.Row="1" Background="#0B0C0D"
            BorderBrush="#2A2D32" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">

        <!-- Brand -->
        <TextBlock Grid.Column="0"
                   Text="SCHLIEREN"
                   FontFamily="Inter, Segoe UI, sans-serif"
                   FontSize="11" FontWeight="Bold" LetterSpacing="4.5"
                   Foreground="#6A7280"
                   VerticalAlignment="Center"
                   Margin="16,0,24,0"/>

        <!-- View tabs -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0">

          <Border Classes="nav-tab active" Name="TabWorkbench"
                  PointerPressed="OnWorkbenchTabClick">
            <TextBlock Text="Workbench"/>
          </Border>

          <Border Classes="nav-tab" Name="TabInterference"
                  PointerPressed="OnInterferenceTabClick">
            <TextBlock Text="Interference"/>
          </Border>

          <Border Classes="nav-tab" Name="TabFlow"
                  PointerPressed="OnFlowTabClick">
            <TextBlock Text="Flow"/>
          </Border>

          <Border Classes="nav-tab" Name="TabConformance"
                  PointerPressed="OnConformanceTabClick">
            <TextBlock Text="Conformance"/>
          </Border>

          <Border Classes="nav-tab" Name="TabHarvest"
                  PointerPressed="OnHarvestTabClick">
            <TextBlock Text="Harvest"/>
          </Border>

        </StackPanel>

        <!-- Run controls -->
        <StackPanel Grid.Column="2" Orientation="Horizontal"
                    Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0">

          <!-- Fork selector -->
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="FORK"
                       FontFamily="Inter, Segoe UI, sans-serif"
                       FontSize="10" FontWeight="Bold" LetterSpacing="1"
                       Foreground="#454B54" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding AvailableForks}"
                      SelectedItem="{Binding SelectedFork}"
                      Background="#111214" Foreground="#A0A8B4"
                      FontSize="12" Height="22" Padding="8,0"
                      MinWidth="80"/>
          </StackPanel>

          <Button Content="{Binding OpSecLabel}"
                  Background="#111214" Foreground="#A0A8B4"
                  FontSize="11" Padding="8,4" CornerRadius="3"
                  Command="{Binding ToggleOpSecCommand}"/>

          <Button Content="LOAD FIXTURE."
                  Background="#111214" Foreground="#6A7280"
                  FontFamily="Inter, Segoe UI, sans-serif"
                  FontSize="11" FontWeight="SemiBold"
                  Padding="10,4" CornerRadius="3"
                  Click="OnLoadPrestateClick"/>

          <Button Content="RUN"
                  Background="#E4E0DC" Foreground="#060607"
                  FontFamily="Inter, Segoe UI, sans-serif"
                  FontSize="11" FontWeight="Bold"
                  Padding="14,4" CornerRadius="3"
                  Command="{Binding RunBytecodeCommand}"
                  IsEnabled="{Binding !IsRunning}"/>

          <Button Content="STOP"
                  Background="#2A0A0A" Foreground="#C43A52"
                  FontFamily="Inter, Segoe UI, sans-serif"
                  FontSize="11" FontWeight="Bold"
                  Padding="10,4" CornerRadius="3"
                  Command="{Binding CancelRunCommand}"
                  IsEnabled="{Binding IsRunning}"/>

        </StackPanel>

      </Grid>
    </Border>
    <!-- SLOT 2: Case bar -->
    <Border Grid.Row="2" Background="#111214"
            BorderBrush="#1E2125" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="20"
                  VerticalAlignment="Center" Margin="16,0">

        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Classes="label" Text="TARGET"/>
          <TextBlock FontFamily="JetBrains Mono, Consolas, monospace"
                     FontSize="13" Foreground="#A0A8B4"
                     Text="{Binding TxTo, FallbackValue='-'}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Classes="label" Text="FORK"/>
          <TextBlock FontFamily="JetBrains Mono, Consolas, monospace"
                     FontSize="13" FontWeight="Medium" Foreground="#E4E0DC"
                     Text="{Binding SelectedFork, FallbackValue='-'}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Classes="label" Text="STEP"/>
          <TextBlock FontFamily="JetBrains Mono, Consolas, monospace"
                     FontSize="13" FontWeight="Medium" Foreground="#E4E0DC"
                     Text="{Binding StepProgress, FallbackValue='-'}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Classes="label" Text="GAS"/>
          <TextBlock FontFamily="JetBrains Mono, Consolas, monospace"
                     FontSize="13" Foreground="#A0A8B4"
                     Text="{Binding GasText, FallbackValue='-'}"/>
        </StackPanel>

      </StackPanel>
    </Border>
    <!-- SLOT 3: Bytecode / file input bar -->
    <Border Grid.Row="3" Background="#0B0C0D"
            BorderBrush="#2A2D32" BorderThickness="0,0,0,1"
            Padding="12,6">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

        <TextBlock Grid.Column="0" Text="BYTECODE"
                   FontFamily="Inter, Segoe UI, sans-serif"
                   FontSize="12" FontWeight="Bold"
                   Foreground="#5B8EC9" LetterSpacing="1"
                   VerticalAlignment="Center" Margin="0,0,10,0"/>

        <TextBox Grid.Column="1"
                 Text="{Binding BytecodeInput}"
                 Watermark="Paste hex bytecode (0x optional)  �  or use Load Fixture."
                 Background="#090A0B" Foreground="#E4E0DC"
                 BorderBrush="#2A2D32" BorderThickness="1"
                 FontFamily="JetBrains Mono, Consolas, monospace"
                 FontSize="13" Padding="8,4" CornerRadius="3"
                 Margin="0,0,8,0"/>

        <Button Grid.Column="2" Content="ADD"
                Background="#181A1D" Foreground="#C8943C"
                FontSize="11" FontWeight="Bold" Padding="8,3" CornerRadius="3" Margin="0,0,4,0"
                Command="{Binding LoadDemoBytecodeCommand}" CommandParameter="add"/>
        <Button Grid.Column="3" Content="LOOP"
                Background="#181A1D" Foreground="#C8943C"
                FontSize="11" FontWeight="Bold" Padding="8,3" CornerRadius="3" Margin="0,0,4,0"
                Command="{Binding LoadDemoBytecodeCommand}" CommandParameter="loop"/>
        <Button Grid.Column="4" Content="TSTORE"
                Background="#181A1D" Foreground="#4BA89A"
                FontSize="11" FontWeight="Bold" Padding="8,3" CornerRadius="3" Margin="0,0,4,0"
                Command="{Binding LoadDemoBytecodeCommand}" CommandParameter="tstore"/>
        <Button Grid.Column="5" Content="KECCAK"
                Background="#181A1D" Foreground="#C8943C"
                FontSize="11" FontWeight="Bold" Padding="8,3" CornerRadius="3" Margin="0,0,8,0"
                Command="{Binding LoadDemoBytecodeCommand}" CommandParameter="keccak"/>

        <Button Grid.Column="6"
                Content="{Binding IsRunning, Converter={x:Static vm:BoolToRunLabelConverter.Instance}}"
                Background="#5B8EC9" Foreground="#060607"
                FontWeight="Bold" FontSize="12" Padding="14,3" CornerRadius="3" Margin="0,0,4,0"
                Command="{Binding RunBytecodeCommand}"
                IsEnabled="{Binding !IsRunning}"/>

        <Button Grid.Column="7" Content="STOP"
                Background="#2A0A0A" Foreground="#C43A52"
                FontWeight="Bold" FontSize="12" Padding="10,3" CornerRadius="3" Margin="0,0,4,0"
                Command="{Binding CancelRunCommand}"
                IsEnabled="{Binding IsRunning}"/>

        <Button Grid.Column="8" Content="RESET"
                Background="#181A1D" Foreground="#6A7280"
                FontSize="11" FontWeight="Bold" Padding="8,3" CornerRadius="3"
                Command="{Binding ResetWorkbenchCommand}"/>

      </Grid>
    </Border>

    <!-- SLOT 4: Workspace -->
    <Grid Grid.Row="4" ColumnDefinitions="*,4,300" Name="WorkspaceGrid">

      <!-- LEFT: view switcher - Workbench / Conformance / Harvest -->
      <Grid Grid.Column="0" Name="MainViewArea">

        <!-- WORKBENCH VIEW -->
        <Grid Name="WorkbenchView" RowDefinitions="*,4,180" IsVisible="True">

          <!-- Upper: disassembly left + machine state right -->
          <Grid Grid.Row="0" ColumnDefinitions="*,4,280">

            <!-- DISASSEMBLY -->
            <Grid Grid.Column="0" RowDefinitions="28,*"
                  Background="#090A0B">
              <Border Grid.Row="0" Background="#111214"
                      BorderBrush="#1E2125" BorderThickness="0,0,0,1"
                      Padding="16,0">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <TextBlock Classes="pane-title" Text="DISASSEMBLY"/>
                  <TextBox Width="64" Height="18"
                           Text="{Binding PcSearch}"
                           Watermark="PC"
                           Background="#090A0B" Foreground="#A0A8B4"
                           FontFamily="JetBrains Mono, Consolas, monospace"
                           FontSize="11" Padding="4,1"
                           BorderBrush="#2A2D32" BorderThickness="1"
                           CornerRadius="2"/>
                  <Button Content="GO" FontSize="10" Padding="6,1" CornerRadius="2"
                          Background="#181A1D" Foreground="#5B8EC9"
                          Command="{Binding JumpToPcCommand}"/>
                  <TextBlock Text="{Binding ExecutionTargetLine}"
                             FontFamily="Inter, Segoe UI, sans-serif"
                             FontSize="12" Foreground="#454B54"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"
                             MaxWidth="300" Margin="8,0,0,0"/>
                </StackPanel>
              </Border>

              <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding Instructions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:InstructionViewModel">
                      <Border Padding="0" Margin="0" CornerRadius="0"
                              Cursor="Hand"
                              Background="{Binding IsActive, Converter={x:Static vm:BoolToColorConverter.Instance}}"
                              PointerPressed="OnInstructionClick">
                        <TextBlock Text="{Binding DisplayText}"
                                   FontFamily="JetBrains Mono, Cascadia Code, Consolas, monospace"
                                   FontSize="13"
                                   Padding="16,5"
                                   Foreground="{Binding IsActive, Converter={x:Static vm:BoolToFGConverter.Instance}}"/>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>

            <!-- SPLITTER: disassembly | machine state -->
            <GridSplitter Grid.Column="1"
                          ResizeDirection="Columns"
                          Background="#2A2D32"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"/>

            <!-- MACHINE STATE -->
            <Border Grid.Column="2" Background="#0B0C0D"
                    BorderBrush="#2A2D32" BorderThickness="0,0,0,0">
              <Grid RowDefinitions="28,*">
                <Border Grid.Row="0" Background="#111214"
                        BorderBrush="#1E2125" BorderThickness="0,0,0,1"
                        Padding="16,0">
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Classes="pane-title" Text="MACHINE STATE — BEFORE OPCODE"/>
                    <TextBlock FontFamily="JetBrains Mono, Consolas, monospace"
                               FontSize="12" Foreground="#454B54"
                               Text="{Binding StepProgress, FallbackValue=''}"/>
                  </StackPanel>
                </Border>
                <ScrollViewer Grid.Row="1">
                  <StackPanel Margin="16,8" Spacing="12">

                    <!-- Step controls -->
                    <Grid ColumnDefinitions="*,*,*,*,*">
                      <Button Grid.Column="0" Content="|?" Height="24" FontSize="12"
                              Command="{Binding JumpToStartCommand}"
                              Background="#181A1D" Foreground="#5B8EC9"/>
                      <Button Grid.Column="1" Content="?"  Height="24" FontSize="12"
                              Command="{Binding StepBackCommand}"
                              Background="#181A1D" Foreground="#5B8EC9"/>
                      <Button Grid.Column="2"
                              Content="{Binding IsAutoPlaying, Converter={x:Static vm:BoolToPlayLabelConverter.Instance}}"
                              Height="24" FontSize="12"
                              Command="{Binding ToggleAutoPlayCommand}"
                              Background="#1F2225" Foreground="#E4E0DC"/>
                      <Button Grid.Column="3" Content="?"  Height="24" FontSize="12"
                              Command="{Binding StepForwardCommand}"
                              Background="#181A1D" Foreground="#5B8EC9"/>
                      <Button Grid.Column="4" Content="?|" Height="24" FontSize="12"
                              Command="{Binding JumpToEndCommand}"
                              Background="#181A1D" Foreground="#5B8EC9"/>
                    </Grid>

                    <Slider Minimum="0" Maximum="{Binding MaxStepIndex}"
                            Value="{Binding CurrentStepIndex}"
                            IsEnabled="{Binding HasTrace}"/>

                    <!-- Verdict -->
                    <Border Background="#0D0E10" BorderBrush="#2A2D32"
                            BorderThickness="1" CornerRadius="3" Padding="10,8">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding ResultVerdict}"
                                   FontFamily="JetBrains Mono, Consolas, monospace"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{Binding ResultBannerColor}"/>
                        <TextBlock Text="{Binding ResultExplain}"
                                   FontFamily="Inter, Segoe UI, sans-serif"
                                   FontSize="13" Foreground="#A0A8B4"
                                   TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>

                    <!-- Opcode notes -->
                    <Border Background="#0D0E10" BorderBrush="#2A2D32"
                            BorderThickness="1" CornerRadius="3" Padding="10,8">
                      <StackPanel Spacing="3">
                        <TextBlock Text="OPCODE"
                                   FontFamily="Inter, Segoe UI, sans-serif"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="#454B54" LetterSpacing="1.5"/>
                        <TextBlock Text="{Binding CurrentOpcodeSpec}"
                                   FontFamily="JetBrains Mono, Consolas, monospace"
                                   FontSize="12" Foreground="#5B8EC9"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CurrentGasFormulaBreakdown}"
                                   FontFamily="JetBrains Mono, Consolas, monospace"
                                   FontSize="11" Foreground="#C8943C"
                                   TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>

                    <!-- Stack -->
                    <StackPanel Spacing="4">
                      <TextBlock Text="STACK"
                                 FontFamily="Inter, Segoe UI, sans-serif"
                                 FontSize="10" FontWeight="Bold"
                                 Foreground="#454B54" LetterSpacing="1.5"/>
                      <TextBox Text="{Binding StackText}" IsReadOnly="True"
                               AcceptsReturn="True"
                               Background="#090A0B" Foreground="#A0A8B4"
                               FontFamily="JetBrains Mono, Consolas, monospace"
                               FontSize="12" TextWrapping="Wrap"
                               MinHeight="54" MaxHeight="120"
                               BorderBrush="#2A2D32" BorderThickness="1"/>
                    </StackPanel>

                    <!-- Storage -->
                    <StackPanel Spacing="4">
                      <TextBlock Text="STORAGE"
                                 FontFamily="Inter, Segoe UI, sans-serif"
                                 FontSize="10" FontWeight="Bold"
                                 Foreground="#454B54" LetterSpacing="1.5"/>
                      <TextBox Text="{Binding StorageText}" IsReadOnly="True"
                               AcceptsReturn="True"
                               Background="#090A0B" Foreground="#C8943C"
                               FontFamily="JetBrains Mono, Consolas, monospace"
                               FontSize="12" TextWrapping="Wrap"
                               MinHeight="40" MaxHeight="120"
                               BorderBrush="#2A2D32" BorderThickness="1"/>
                    </StackPanel>

                    <!-- Return data -->
                    <StackPanel Spacing="4">
                      <TextBlock Text="RETURN DATA"
                                 FontFamily="Inter, Segoe UI, sans-serif"
                                 FontSize="10" FontWeight="Bold"
                                 Foreground="#454B54" LetterSpacing="1.5"/>
                      <TextBox Text="{Binding ReturnDataHex}" IsReadOnly="True"
                               Background="#090A0B" Foreground="#4BA89A"
                               FontFamily="JetBrains Mono, Consolas, monospace"
                               FontSize="11" TextWrapping="Wrap"
                               MaxHeight="60"
                               BorderBrush="#2A2D32" BorderThickness="1"/>
                    </StackPanel>

                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Border>

          </Grid>

          <!-- SPLITTER: upper | trace -->
          <GridSplitter Grid.Row="1"
                        ResizeDirection="Rows"
                        Background="#2A2D32"
                        Height="4"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"/>

          <!-- TRACE pane -->
          <Grid Grid.Row="2" RowDefinitions="28,*" Background="#060607">
            <Border Grid.Row="0" Background="#111214"
                    BorderBrush="#1E2125" BorderThickness="0,1,0,1"
                    Padding="16,0">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Classes="pane-title" Text="TRACE"/>
                <TextBlock FontFamily="Inter, Segoe UI, sans-serif"
                           FontSize="12" Foreground="#454B54"
                           Text="{Binding StepProgress, FallbackValue=''}"/>
                <TextBlock FontFamily="Inter, Segoe UI, sans-serif"
                           FontSize="12" Foreground="#454B54"
                           Text="{Binding StepPercentage, FallbackValue=''}"/>
                <TextBlock FontFamily="JetBrains Mono, Consolas, monospace"
                           FontSize="11" Foreground="#C8943C"
                           Text="{Binding ResultBanner}"
                           TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                <TextBlock FontFamily="JetBrains Mono, Consolas, monospace"
                           FontSize="11" Foreground="#6A7280"
                           Text="{Binding CurrentStepDetail}"/>
              </StackPanel>
            </Border>
            <Grid Grid.Row="1" ColumnDefinitions="*,4,*,4,*">
              <Border Grid.Column="0" Background="#090A0B" BorderBrush="#1E2125" BorderThickness="0,1,0,0">
                <Grid RowDefinitions="22,*">
                  <Border Grid.Row="0" Background="#111214" BorderBrush="#2A2D32" BorderThickness="0,0,0,1" Padding="10,0">
                    <TextBlock Text="STACK" FontFamily="Inter, Segoe UI, sans-serif" FontSize="9" FontWeight="Bold" LetterSpacing="1.8" Foreground="#5B8EC9" VerticalAlignment="Center"/>
                  </Border>
                  <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding StackRows}" Margin="10,4">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Text="{Binding}" Classes="data" FontSize="11" Padding="0,2"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Border>
              <Border Grid.Column="1" Background="#1E2125"/>
              <Border Grid.Column="2" Background="#090A0B" BorderBrush="#1E2125" BorderThickness="0,1,0,0">
                <Grid RowDefinitions="22,*">
                  <Border Grid.Row="0" Background="#111214" BorderBrush="#2A2D32" BorderThickness="0,0,0,1" Padding="10,0">
                    <TextBlock Text="MEMORY" FontFamily="Inter, Segoe UI, sans-serif" FontSize="9" FontWeight="Bold" LetterSpacing="1.8" Foreground="#4BA89A" VerticalAlignment="Center"/>
                  </Border>
                  <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding MemoryRows}" Margin="10,4">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Text="{Binding}" Classes="data" FontSize="11" Padding="0,2"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Border>
              <Border Grid.Column="3" Background="#1E2125"/>
              <Border Grid.Column="4" Background="#090A0B" BorderBrush="#1E2125" BorderThickness="0,1,0,0">
                <Grid RowDefinitions="22,*">
                  <Border Grid.Row="0" Background="#111214" BorderBrush="#2A2D32" BorderThickness="0,0,0,1" Padding="10,0">
                    <TextBlock Text="STORAGE" FontFamily="Inter, Segoe UI, sans-serif" FontSize="9" FontWeight="Bold" LetterSpacing="1.8" Foreground="#C8943C" VerticalAlignment="Center"/>
                  </Border>
                  <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding StorageRows}" Margin="10,4">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Text="{Binding}" Classes="data" FontSize="11" Padding="0,2"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </Grid>

        <!-- CONFORMANCE VIEW -->
        <views:ConformanceView x:Name="ConformancePanel" IsVisible="False"/>

        <!-- HARVEST VIEW -->
        <views:HarvestView x:Name="HarvestPanel" IsVisible="False"/>

      </Grid>

      <!-- SPLITTER: main | diagnostics -->
      <GridSplitter Grid.Column="1"
                    ResizeDirection="Columns"
                    Background="#2A2D32"
                    Width="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"/>

      <!-- RIGHT: Diagnostics panel -->
      <Border Grid.Column="2" Background="#0B0C0D"
              BorderBrush="#2A2D32" BorderThickness="1,0,0,0"
              Name="DiagnosticsPanel">
        <Grid RowDefinitions="28,*">

          <Border Grid.Row="0" Background="#111214"
                  BorderBrush="#1E2125" BorderThickness="0,0,0,1"
                  Padding="16,0">
            <TextBlock Classes="pane-title" Text="DIAGNOSTICS"
                       VerticalAlignment="Center"/>
          </Border>

          <ScrollViewer Grid.Row="1">
            <StackPanel Margin="0">

              <!-- DIAGNOSIS -->
              <Border BorderBrush="#B89B4A" BorderThickness="0,0,0,1"
                      Padding="16,14">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Width="3" Height="14" Background="#B89B4A" CornerRadius="2"/>
                    <TextBlock Text="EXECUTION DIAGNOSIS"
                               FontFamily="Inter, Segoe UI, sans-serif"
                               FontSize="12" FontWeight="Bold"
                               Foreground="#A0A8B4" LetterSpacing="1.8"/>
                  </StackPanel>
                  <Border Background="#111214" BorderBrush="#2A2D32"
                          BorderThickness="1,1,1,3" CornerRadius="3"
                          Padding="12,10">
                    <Border.BorderBrush>
                      <SolidColorBrush Color="#B89B4A"/>
                    </Border.BorderBrush>
                    <StackPanel Spacing="6">
                      <TextBlock Text="{Binding CurrentOpcodeSpec, FallbackValue='No execution'}"
                                 FontFamily="Inter, Segoe UI, sans-serif"
                                 FontSize="13" FontWeight="SemiBold"
                                 Foreground="#E4E0DC" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding CurrentGasFormulaBreakdown}"
                                 FontFamily="JetBrains Mono, Consolas, monospace"
                                 FontSize="11" Foreground="#C8943C"
                                 TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding CurrentStepDetail}"
                                 FontFamily="JetBrains Mono, Consolas, monospace"
                                 FontSize="11" Foreground="#6A7280"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>

              <!-- SECURITY -->
              <Border BorderBrush="#2A2D32" BorderThickness="0,0,0,1"
                      Padding="16,14">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Width="3" Height="14" Background="#7B5EA7" CornerRadius="2"/>
                    <TextBlock Text="SECURITY FINDINGS"
                               FontFamily="Inter, Segoe UI, sans-serif"
                               FontSize="12" FontWeight="Bold"
                               Foreground="#A0A8B4" LetterSpacing="1.8"/>
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding SecurityFindings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SecurityFindingViewModel">
                        <Border Background="#111214"
                                BorderBrush="#7B5EA7"
                                BorderThickness="3,1,1,1"
                                CornerRadius="3" Padding="10,8" Margin="0,0,0,6">
                          <StackPanel Spacing="3">
                            <TextBlock Text="{Binding SeverityEmoji}"
                                       FontSize="12"/>
                            <TextBlock Text="{Binding Description}"
                                       FontFamily="Inter, Segoe UI, sans-serif"
                                       FontSize="12" Foreground="#E4E0DC"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Details}"
                                       FontFamily="Inter, Segoe UI, sans-serif"
                                       FontSize="11" Foreground="#6A7280"
                                       TextWrapping="Wrap"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding EmptyFindingsText}"
                             IsVisible="{Binding !HasSecurityFindings}"
                             FontFamily="Inter, Segoe UI, sans-serif"
                             FontSize="12" Foreground="#454B54"/>
                </StackPanel>
              </Border>

              <!-- DIAGNOSIS TEXT (full) -->
              <Border BorderBrush="#2A2D32" BorderThickness="0,0,0,1"
                      Padding="16,14">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Width="3" Height="14" Background="#5B8EC9" CornerRadius="2"/>
                    <TextBlock Text="CAUSAL ANALYSIS"
                               FontFamily="Inter, Segoe UI, sans-serif"
                               FontSize="12" FontWeight="Bold"
                               Foreground="#A0A8B4" LetterSpacing="1.8"/>
                  </StackPanel>
                  <TextBox Text="{Binding DiagnosisText}" IsReadOnly="True"
                           AcceptsReturn="True"
                           Background="#090A0B" Foreground="#B89B4A"
                           FontFamily="JetBrains Mono, Consolas, monospace"
                           FontSize="12" TextWrapping="Wrap"
                           MinHeight="80" MaxHeight="200"
                           BorderBrush="#2A2D32" BorderThickness="1"/>
                </StackPanel>
              </Border>

              <!-- EXPORT ACTIONS -->
              <StackPanel Orientation="Horizontal" Spacing="8"
                          Margin="16,12">
                <Button Content="EXPORT TRACE"
                        FontFamily="Inter, Segoe UI, sans-serif"
                        FontSize="10" FontWeight="Bold"
                        Background="#181A1D" Foreground="#C8943C"
                        Padding="10,4" CornerRadius="3"
                        Click="OnExportTraceClick"/>
                <Button Content="EXPORT AUDIT"
                        FontFamily="Inter, Segoe UI, sans-serif"
                        FontSize="10" FontWeight="Bold"
                        Background="#181A1D" Foreground="#5B8EC9"
                        Padding="10,4" CornerRadius="3"
                        Click="OnExportReportClick"/>
              </StackPanel>

            </StackPanel>
          </ScrollViewer>

        </Grid>
      </Border>

    </Grid>
    <!-- SLOT 5: Status bar -->
    <Border Grid.Row="5" Background="#0B0C0D"
            BorderBrush="#2A2D32" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" Margin="16,0">
        <TextBlock Grid.Column="0"
                   Text="{Binding StatusMessage}"
                   FontFamily="Inter, Segoe UI, sans-serif"
                   FontSize="12" Foreground="#454B54"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="1"
                   Text="Schlieren 1.0 � .NET 8"
                   FontFamily="Inter, Segoe UI, sans-serif"
                   FontSize="10" Foreground="#2A2D32"
                   VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
  </LayoutTransformControl>

</Window>