{
  "commands": [
    "set -e",
    "cd /opt/guard-out",
    "for i in 1 2 3 4 5; do",
    "  TIMESTART=$(date +%s%3N)",
    "  curl -s -m 60 -X POST http://127.0.0.1:18545 -H content-type:application/json -d '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"schlieren_guard\",\"params\":[{\"token\":\"0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48\"}]}' > /dev/null",
    "  TIMEEND=$(date +%s%3N)",
    "  echo \"run$i=$((TIMEEND - TIMESTART))ms\"",
    "done"
  ]
}
