<Window x:Class="Scrutor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:Scrutor.UI.Converters"
        xmlns:vm="clr-namespace:Scrutor.UI.ViewModels"
        mc:Ignorable="d"
        Title="Scrutor Control Plane" Height="700" Width="1000"
        Background="#121212" Foreground="White"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToInverseVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:StatusToStartVisibilityConverter x:Key="StatusToStartVisibility" />
        <conv:StatusToStopVisibilityConverter x:Key="StatusToStopVisibility" />
        <conv:StringNullOrEmptyToVisibilityConverter x:Key="StringVisible" />
        
        <Style x:Key="DashboardButton" TargetType="Button">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabHeaderStyle" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" Background="{TemplateBinding Background}" BorderBrush="#007ACC" BorderThickness="0,0,0,0">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#007ACC"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="0,0,0,2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Content -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E1E1E" Padding="24,16" BorderBrush="#333333" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="SCRUTOR" FontSize="24" FontWeight="Black" Foreground="#007ACC" VerticalAlignment="Center"/>
                    <Border Background="#333333" CornerRadius="4" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="V1.0.0" FontSize="10" FontWeight="Bold" Foreground="#AAAAAA"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!-- Status Badge -->
                    <Border Padding="12,6" CornerRadius="16" Background="#252526" VerticalAlignment="Center" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#777777"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Active">
                                                <Setter Property="Fill" Value="#107C10"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Error">
                                                <Setter Property="Fill" Value="#D13438"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="Bold" Opacity="0.8"/>
                        </StackPanel>
                    </Border>

                    <!-- Control Buttons -->
                    <Button Content="START NODE" Command="{Binding StartCommand}" Background="#007ACC" Width="120" Height="36" Style="{StaticResource DashboardButton}"
                            Visibility="{Binding Status, Converter={StaticResource StatusToStartVisibility}}"/>
                    <Button Content="STOP NODE" Command="{Binding StopCommand}" Background="#D13438" Width="120" Height="36" Style="{StaticResource DashboardButton}"
                            Visibility="{Binding Status, Converter={StaticResource StatusToStopVisibility}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tab Content -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- TAB: DASHBOARD -->
            <TabItem Header="DASHBOARD" Style="{StaticResource TabHeaderStyle}">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Metric: Block Height -->
                        <Border Background="#1E1E1E" Padding="20" CornerRadius="8" Margin="0,0,12,0" BorderBrush="#333333" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="BLOCK HEIGHT" FontSize="11" FontWeight="Bold" Opacity="0.5" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding BlockHeight}" FontSize="32" FontWeight="Bold" Foreground="#007ACC"/>
                            </StackPanel>
                        </Border>

                        <!-- Metric: Mempool -->
                        <Border Grid.Column="1" Background="#1E1E1E" Padding="20" CornerRadius="8" Margin="12,0,12,0" BorderBrush="#333333" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="PENDING TRANSACTIONS" FontSize="11" FontWeight="Bold" Opacity="0.5" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding MempoolCount}" FontSize="32" FontWeight="Bold" Foreground="#E19600"/>
                            </StackPanel>
                        </Border>

                        <!-- Metric: Accounts -->
                        <Border Grid.Column="2" Background="#1E1E1E" Padding="20" CornerRadius="8" Margin="12,0,0,0" BorderBrush="#333333" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="MANAGED ACCOUNTS" FontSize="11" FontWeight="Bold" Opacity="0.5" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding ManagedAccounts.Count}" FontSize="32" FontWeight="Bold" Foreground="#76EF76"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Config Panel -->
                    <Border Grid.Row="1" Margin="0,24,0,0" Background="#1E1E1E" CornerRadius="8" Padding="24" BorderBrush="#333333" BorderThickness="1">
                        <ScrollViewer>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                    <TextBlock Text="NETWORK CONFIGURATION" FontWeight="Bold" Opacity="0.6" Margin="0,0,0,16"/>
                                    
                                    <TextBlock Text="RPC Port" Margin="0,0,0,4" Opacity="0.5" FontSize="11"/>
                                    <TextBox Text="{Binding Port}" IsEnabled="{Binding IsInactive}" Margin="0,0,0,16" Padding="8" Background="#2D2D30" Foreground="White" BorderThickness="0"/>

                                    <TextBlock Text="Chain ID" Margin="0,0,0,4" Opacity="0.5" FontSize="11"/>
                                    <TextBox Text="{Binding ChainId}" IsEnabled="{Binding IsInactive}" Margin="0,0,0,16" Padding="8" Background="#2D2D30" Foreground="White" BorderThickness="0"/>
                                    
                                    <TextBlock Text="Fork URL (Optional)" Margin="0,0,0,4" Opacity="0.5" FontSize="11"/>
                                    <TextBox Text="{Binding ForkUrl}" IsEnabled="{Binding IsInactive}" Margin="0,0,0,8" Padding="8" Background="#2D2D30" Foreground="White" BorderThickness="0"/>
                                    
                                    <TextBlock Text="Fork Block Number (Optional)" Margin="0,0,0,4" Opacity="0.5" FontSize="11"/>
                                    <TextBox Text="{Binding ForkBlock}" IsEnabled="{Binding IsInactive}" Margin="0,0,0,16" Padding="8" Background="#2D2D30" Foreground="White" BorderThickness="0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="DEV ACCOUNTS (HD WALLET)" FontWeight="Bold" Opacity="0.6" Margin="0,0,0,16"/>

                                    <TextBlock Text="Number of Accounts" Margin="0,0,0,4" Opacity="0.5" FontSize="11"/>
                                    <TextBox Text="{Binding Accounts}" IsEnabled="{Binding IsInactive}" Margin="0,0,0,16" Padding="8" Background="#2D2D30" Foreground="White" BorderThickness="0"/>

                                    <TextBlock Text="Initial Balance (ETH)" Margin="0,0,0,4" Opacity="0.5" FontSize="11"/>
                                    <TextBox Text="{Binding InitialBalance}" IsEnabled="{Binding IsInactive}" Margin="0,0,0,16" Padding="8" Background="#2D2D30" Foreground="White" BorderThickness="0"/>

                                    <CheckBox Content="Auto-Impersonate all accounts" IsChecked="{Binding AutoImpersonate}" IsEnabled="{Binding IsInactive}" Foreground="White" Margin="0,0,0,16"/>

                                    <TextBlock Text="Mnemonic Phrase (Auto-generated if empty)" Margin="0,0,0,4" Opacity="0.5" FontSize="11"/>
                                    <TextBox Text="{Binding Mnemonic}" IsEnabled="{Binding IsInactive}" Margin="0,0,0,16" Padding="8" Background="#2D2D30" Foreground="White" BorderThickness="0" TextWrapping="Wrap" MinHeight="48"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB: WALLET -->
            <TabItem Header="ACCOUNTS" Style="{StaticResource TabHeaderStyle}">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#1E1E1E" Padding="16" CornerRadius="8" Margin="0,0,0,16" BorderBrush="#333333" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="ACTIVE MNEMONIC" FontSize="11" FontWeight="Bold" Opacity="0.5" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding Mnemonic}" FontSize="14" FontFamily="Consolas" Foreground="#CCCC00" IsHitTestVisible="True"/>
                        </StackPanel>
                    </Border>

                    <ListView Grid.Row="1" ItemsSource="{Binding ManagedAccounts}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="#1E1E1E"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Padding" Value="12"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="#333333" BorderThickness="1">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Index / Status -->
                                    <Border Width="24" Height="24" Background="#333333" CornerRadius="12" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="ID" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
                                    </Border>

                                    <!-- Address -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="ADDRESS" FontSize="9" FontWeight="Bold" Opacity="0.4" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding Address}" FontFamily="Consolas" FontSize="13" Foreground="#007ACC"/>
                                    </StackPanel>

                                    <!-- Balance -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="24,0">
                                        <TextBlock Text="BALANCE" FontSize="9" FontWeight="Bold" Opacity="0.4" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding Balance}" FontWeight="Bold" FontSize="13"/>
                                    </StackPanel>

                                    <!-- Private Key -->
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Text="PRIVATE KEY" FontSize="9" FontWeight="Bold" Opacity="0.4" Margin="0,0,0,2"/>
                                        <Grid>
                                            <TextBlock Text="{Binding MaskedPrivateKey}" Opacity="0.5" FontFamily="Consolas" Visibility="{Binding ShowPrivateKey, Converter={StaticResource InverseBoolToVis}}"/>
                                            <TextBlock Text="{Binding PrivateKey}" FontFamily="Consolas" Foreground="#D4D4D4" Visibility="{Binding ShowPrivateKey, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Actions -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ToggleButton Command="{Binding TogglePrivateKeyCommand}" Background="Transparent" BorderThickness="0" Margin="0,0,8,0">
                                            <TextBlock Text="👁" FontSize="18"/>
                                        </ToggleButton>
                                        <Border Background="#1A331A" CornerRadius="4" Padding="6,2" Visibility="{Binding IsImpersonated, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="UNLOCKED" FontSize="9" FontWeight="Bold" Foreground="#76EF76"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabItem>

            <!-- TAB: DEBUGGER -->
            <TabItem Header="DEBUGGER" Style="{StaticResource TabHeaderStyle}">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <UniformGrid Columns="2">
                        <!-- Mine Block -->
                        <Border Background="#1E1E1E" Padding="24" CornerRadius="8" Margin="0,0,12,0" BorderBrush="#333333" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="MANUAL MINING" FontWeight="Bold" Opacity="0.6" Margin="0,0,0,8"/>
                                <TextBlock Text="Trigger block production immediately using the current mempool state." Opacity="0.5" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>
                                <Button Content="MINE BLOCK" Command="{Binding MineBlockCommand}" Background="#007ACC" Height="36" Style="{StaticResource DashboardButton}"/>
                            </StackPanel>
                        </Border>

                        <!-- Advance Time -->
                        <Border Background="#1E1E1E" Padding="24" CornerRadius="8" Margin="12,0,0,0" BorderBrush="#333333" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="TIME TRAVEL" FontWeight="Bold" Opacity="0.6" Margin="0,0,0,8"/>
                                <TextBlock Text="Increase the node's internal clock offset (in seconds)." Opacity="0.5" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TimeValue" Text="3600" Padding="8" Background="#2D2D30" Foreground="White" BorderThickness="0" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="ADD TIME" Command="{Binding IncreaseTimeCommand}" CommandParameter="{Binding Text, ElementName=TimeValue}" 
                                            Background="#E19600" Width="100" Height="34" Margin="12,0,0,0" Style="{StaticResource DashboardButton}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    
                    <!-- Advanced Cheatcodes placeholders -->
                    <Border Grid.Row="1" Margin="0,24,0,0" Background="#1E1E1E" CornerRadius="8" Padding="24" BorderBrush="#333333" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="CHEATCODE SCRIPTS" FontWeight="Bold" Opacity="0.6" Margin="0,0,0,16"/>
                            <TextBlock Text="Cheatcode scripting and state overrides via UI are coming soon." Opacity="0.4" FontStyle="Italic"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB: LOGS -->
            <TabItem Header="LOGS" Style="{StaticResource TabHeaderStyle}">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="SYSTEM OUTPUT" FontSize="11" FontWeight="Bold" Opacity="0.6" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ComboBox SelectedValue="{Binding LogLevelFilter}" Width="100" Margin="0,0,12,0" Background="#333333" Foreground="White" BorderThickness="1" BorderBrush="#555555">
                                <ComboBoxItem Content="ALL"/>
                                <ComboBoxItem Content="INFO"/>
                                <ComboBoxItem Content="DEBUG"/>
                                <ComboBoxItem Content="WARN"/>
                                <ComboBoxItem Content="ERROR"/>
                            </ComboBox>
                            <ToggleButton IsChecked="{Binding IsLogsPaused}" Content="PAUSE LOGS" Padding="12,2" Background="#2D2D30" Foreground="White" BorderThickness="1" BorderBrush="#555555"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Background="#0A0A0A" CornerRadius="6" BorderBrush="#333333" BorderThickness="1">
                        <ListBox ItemsSource="{Binding Logs}" Background="Transparent" BorderThickness="0" Foreground="#CCCCCC" FontFamily="Consolas" FontSize="12" Padding="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
