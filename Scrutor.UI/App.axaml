<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Scrutor.UI.App"
             Name="SCRUTOR"
             RequestedThemeVariant="Dark">
    <!-- Colors come from SkinService DynamicResource keys (see Branding/SkinCatalog). -->
    <Application.Resources>
        <!-- Fallbacks before SkinService.LoadAndApply runs -->
        <SolidColorBrush x:Key="Scrutor.ShellBg" Color="#0B0E14"/>
        <SolidColorBrush x:Key="Scrutor.PanelDeep" Color="#0D1117"/>
        <SolidColorBrush x:Key="Scrutor.PanelBg" Color="#151B23"/>
        <SolidColorBrush x:Key="Scrutor.PanelElevated" Color="#1C2430"/>
        <SolidColorBrush x:Key="Scrutor.Border" Color="#2A3441"/>
        <SolidColorBrush x:Key="Scrutor.BorderSubtle" Color="#232B36"/>
        <SolidColorBrush x:Key="Scrutor.TextPrimary" Color="#E6EDF3"/>
        <SolidColorBrush x:Key="Scrutor.TextMuted" Color="#9AA7B5"/>
        <SolidColorBrush x:Key="Scrutor.TextDim" Color="#6B7785"/>
        <SolidColorBrush x:Key="Scrutor.Accent" Color="#6C9EFF"/>
        <SolidColorBrush x:Key="Scrutor.AccentAlt" Color="#7FDBCA"/>
        <SolidColorBrush x:Key="Scrutor.AccentHover" Color="#8FB4FF"/>
        <SolidColorBrush x:Key="Scrutor.AccentSoft" Color="#A8B4FF"/>
        <SolidColorBrush x:Key="Scrutor.Success" Color="#3DDC97"/>
        <SolidColorBrush x:Key="Scrutor.Danger" Color="#FF6B7A"/>
        <SolidColorBrush x:Key="Scrutor.Warning" Color="#E6C07B"/>
        <SolidColorBrush x:Key="Scrutor.Alert" Color="#FF8A65"/>
        <SolidColorBrush x:Key="Scrutor.ActiveLineBg" Color="#1A2740"/>
        <SolidColorBrush x:Key="Scrutor.VulnerableLineBg" Color="#2A1818"/>
        <SolidColorBrush x:Key="Scrutor.SelectionBg" Color="#243044"/>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Button.brand-primary">
            <Setter Property="Background" Value="{DynamicResource Scrutor.Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource Scrutor.TextPrimary}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.brand-primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Scrutor.AccentHover}"/>
        </Style>
        <Style Selector="TextBlock.brand-aqua">
            <Setter Property="Foreground" Value="{DynamicResource Scrutor.AccentAlt}"/>
        </Style>
        <Style Selector="TextBlock.brand-white">
            <Setter Property="Foreground" Value="{DynamicResource Scrutor.TextPrimary}"/>
        </Style>
        <Style Selector="TextBlock.brand-muted">
            <Setter Property="Foreground" Value="{DynamicResource Scrutor.TextMuted}"/>
        </Style>
        <Style Selector="TextBlock.brand-alert">
            <Setter Property="Foreground" Value="{DynamicResource Scrutor.Alert}"/>
        </Style>
        <Style Selector="TextBlock.brand-warm">
            <Setter Property="Foreground" Value="{DynamicResource Scrutor.Warning}"/>
        </Style>
        <Style Selector="Menu">
            <Setter Property="Background" Value="{DynamicResource Scrutor.PanelDeep}"/>
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource Scrutor.TextPrimary}"/>
        </Style>
    </Application.Styles>
</Application>
