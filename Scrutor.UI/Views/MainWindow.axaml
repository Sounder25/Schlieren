<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Scrutor.UI.ViewModels"
        x:Class="Scrutor.UI.Views.MainWindow"
        x:Name="root"
        x:DataType="vm:WorkbenchViewModel"
        Title="SCRUTOR — .NET 8 Ethereum Execution &amp; Verification Engine"
        Icon="/Assets/scrutor-icon.png"
        Width="1440" Height="900"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D0D"
        FontFamily="Inter, Segoe UI, sans-serif">

    <Window.Styles>
        <Style Selector="TextBlock.header">
            <Setter Property="Foreground" Value="#19D7E5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#1A1A2E"/>
            <Setter Property="BorderBrush" Value="#2D2D2D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="TextBlock.code">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#F0F4F8"/>
        </Style>
        <Style Selector="TextBlock.linenumber">
            <Setter Property="Foreground" Value="#19D7E5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace"/>
        </Style>
        <Style Selector="Border.activeLine">
            <Setter Property="Background" Value="#241B47"/>
            <Setter Property="BorderBrush" Value="#19D7E5"/>
            <Setter Property="BorderThickness" Value="2,0,0,0"/>
        </Style>
        <Style Selector="Border.vulnerableLine">
            <Setter Property="Background" Value="#2E141B"/>
            <Setter Property="BorderBrush" Value="#FF4500"/>
            <Setter Property="BorderThickness" Value="2,0,0,0"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
        <!-- MENU -->
        <Menu Grid.Row="0" Background="#0C0D14" BorderBrush="#2D2D3D" BorderThickness="0,0,0,1" Height="26">
            <MenuItem Header="_File" Foreground="#E0E0E0" FontSize="11">
                <MenuItem Header="Open Contract File..." Click="OnOpenFileClick" InputGesture="Ctrl+O"/>
                <MenuItem Header="Open Project Folder..." Click="OnOpenFolderClick" InputGesture="Ctrl+Shift+O"/>
                <Separator/>
                <MenuItem Header="Export Security Audit Report (.md)..." Click="OnExportReportClick"/>
                <Separator/>
                <MenuItem Header="Exit" Click="OnExitClick" InputGesture="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="_EVM Engine" Foreground="#E0E0E0" FontSize="11">
                <MenuItem Header="Run Bytecode (Live EVM)" Command="{Binding RunBytecodeCommand}" InputGesture="F5"/>
                <MenuItem Header="Synthetic Detector Demo..." Command="{Binding RunSyntheticDemoCommand}"/>
            </MenuItem>
            <MenuItem Header="_Tools" Foreground="#E0E0E0" FontSize="11">
                <MenuItem Header="Show Call Topology" Command="{Binding ShowCallGraphCommand}"/>
                <MenuItem Header="Show Source" Command="{Binding ShowSourceCommand}"/>
                <MenuItem Header="Toggle OpSec Lockout" Command="{Binding ToggleOpSecCommand}"/>
                <MenuItem Header="Export Audit Report (.md)..." Click="OnExportReportClick"/>
            </MenuItem>
            <MenuItem Header="_Help" Foreground="#E0E0E0" FontSize="11">
                <MenuItem Header="F5 Run · F10 Step · F11 Back · Space Play · Home/End"/>
            </MenuItem>
        </Menu>

        <!-- TOP BAR (brand) -->
        <Border Grid.Row="1" Background="#0C0D14" Padding="14,8" BorderBrush="#2D2D2D" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="10" Background="#12131A"
                            BorderBrush="#2D2D4D" BorderThickness="1" Padding="4"
                            VerticalAlignment="Center"
                            ToolTip.Tip="SCRUTOR — Precise · Verifiable · Traceable · Conformant">
                        <Image Source="/Assets/scrutor-icon.png"
                               Stretch="Uniform"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="SCRUTOR" FontWeight="Bold" FontSize="20"
                                   Foreground="#F0F4F8" LetterSpacing="2"/>
                        <TextBlock Text=".NET 8 Ethereum Execution &amp; Verification Engine"
                                   FontSize="11" Foreground="#19D7E5"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                    <TextBlock Text="{Binding CurrentFileTitle}" Foreground="#888" FontSize="12" VerticalAlignment="Center"/>
                    <Border Background="#1E1E2E" Padding="6,2" CornerRadius="3" BorderBrush="#2D2D3D" BorderThickness="1"
                            ToolTip.Tip="Report fork label only. Live runs use the unified modern opcode set. Block fields below ARE applied.">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="REPORT FORK:" Foreground="#888" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding AvailableForks}" SelectedItem="{Binding SelectedFork}"
                                      Background="#0D0D0D" Foreground="#19D7E5" FontWeight="Bold" FontSize="11" Height="24" Padding="6,2"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Border Background="#1E1E2E" Padding="10,4" CornerRadius="3" BorderBrush="#2D2D3D" BorderThickness="1"
                            ToolTip.Tip="{Binding ForkNote}">
                        <TextBlock Text="{Binding ForkNote}" Foreground="#A0A0B0" FontSize="10" MaxWidth="280" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Button Content="{Binding OpSecLabel}" Background="#1E1E2E" Foreground="#19D7E5" FontSize="11"
                            Padding="10,4" CornerRadius="3" Command="{Binding ToggleOpSecCommand}"/>
                    <Button Classes="brand-primary" Content="RUN BYTECODE"
                            Padding="16,6" FontSize="12"
                            Command="{Binding RunBytecodeCommand}"
                            IsEnabled="{Binding !IsRunning}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TABS -->
        <Border Grid.Row="2" Background="#141414" Padding="16,6" BorderBrush="#2D2D2D" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="0">
                    <ItemsControl ItemsSource="{Binding ProjectFiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="0"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProjectFileViewModel">
                                <Border Padding="10,6" CornerRadius="4,4,0,0"
                                        Background="{Binding IsSelected, Converter={x:Static vm:BoolToColorConverter.Instance}}"
                                        PointerPressed="OnTabClick"
                                        Cursor="Hand" Margin="0,0,2,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding FileName}"
                                                   Foreground="{Binding IsSelected, Converter={x:Static vm:BoolToFGConverter.Instance}}"
                                                   FontWeight="{Binding IsSelected, Converter={x:Static vm:BoolToFontWeightConverter.Instance}}"
                                                   FontSize="12"/>
                                        <Button Content="×" FontSize="10" Foreground="#888" Background="Transparent" Padding="2,0" Margin="4,0,0,0"
                                                Command="{Binding #root.DataContext.CloseTabCommand}" CommandParameter="{Binding}"
                                                x:CompileBindings="False" ToolTip.Tip="Close tab"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Width="1" Height="16" Background="#2D2D2D" Margin="12,0,12,0" VerticalAlignment="Center"/>
                    <Border Padding="12,6" CornerRadius="4,4,0,0" Background="#1E1E2E"
                            PointerPressed="OnCallGraphClick" Cursor="Hand">
                        <TextBlock Text="CALL GRAPH" Foreground="#FFD700" FontWeight="Bold" FontSize="12"/>
                    </Border>
                    <Border Padding="12,6" CornerRadius="4,4,0,0" Background="#1E1E2E" Margin="4,0,0,0"
                            PointerPressed="OnSourceClick" Cursor="Hand">
                        <TextBlock Text="SOURCE" Foreground="#19D7E5" FontWeight="Bold" FontSize="12"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button Content="EXPORT TRACE" FontSize="10" FontWeight="SemiBold"
                            Background="#1E1E2E" Foreground="#FFD700" Padding="10,4" CornerRadius="3"
                            Click="OnExportTraceClick" ToolTip.Tip="Export structLog JSON"/>
                    <Button Content="BLOCK" FontSize="10" FontWeight="SemiBold"
                            Background="#1E1E2E" Foreground="#19D7E5" Padding="10,4" CornerRadius="3"
                            Command="{Binding ToggleBlockContextCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BYTECODE + TX + BLOCK CONTEXT -->
        <Border Grid.Row="3" Background="#0F0F1A" Padding="12,8" BorderBrush="#2D2D4D" BorderThickness="0,0,0,1">
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="BYTECODE" Foreground="#19D7E5" FontWeight="Bold" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding BytecodeInput}"
                             Watermark="Paste hex bytecode (0x optional) e.g. 600560030160005260206000f3"
                             Background="#1A1C23" Foreground="#F0F4F8"
                             BorderBrush="#4A00E0" BorderThickness="1"
                             FontFamily="Consolas, Menlo, monospace" FontSize="12"
                             Padding="8,4" CornerRadius="3" Margin="0,0,8,0"/>
                    <Button Grid.Column="2" Content="ADD" ToolTip.Tip="PUSH1 5 + PUSH1 3 + ADD + RETURN"
                            Background="#1E1E2E" Foreground="#FFD700" FontSize="10" FontWeight="Bold"
                            Padding="8,4" CornerRadius="3" Margin="0,0,4,0"
                            Command="{Binding LoadDemoBytecodeCommand}" CommandParameter="add"/>
                    <Button Grid.Column="3" Content="LOOP"
                            Background="#1E1E2E" Foreground="#FFD700" FontSize="10" FontWeight="Bold"
                            Padding="8,4" CornerRadius="3" Margin="0,0,4,0"
                            Command="{Binding LoadDemoBytecodeCommand}" CommandParameter="loop"/>
                    <Button Grid.Column="4" Content="TSTORE"
                            Background="#1E1E2E" Foreground="#00D4AA" FontSize="10" FontWeight="Bold"
                            Padding="8,4" CornerRadius="3" Margin="0,0,4,0"
                            Command="{Binding LoadDemoBytecodeCommand}" CommandParameter="tstore"/>
                    <Button Grid.Column="5" Content="KECCAK"
                            Background="#1E1E2E" Foreground="#FFD700" FontSize="10" FontWeight="Bold"
                            Padding="8,4" CornerRadius="3" Margin="0,0,8,0"
                            Command="{Binding LoadDemoBytecodeCommand}" CommandParameter="keccak"/>
                    <Button Grid.Column="6"
                            Content="{Binding IsRunning, Converter={x:Static vm:BoolToRunLabelConverter.Instance}}"
                            Background="#4A00E0" Foreground="White"
                            FontWeight="Bold" FontSize="12" Padding="14,6" CornerRadius="4" Margin="0,0,4,0"
                            Command="{Binding RunBytecodeCommand}"
                            IsEnabled="{Binding !IsRunning}"/>
                    <Button Grid.Column="7" Content="STOP" ToolTip.Tip="Cancel in-flight run"
                            Background="#3D1414" Foreground="#FF4500" FontWeight="Bold" FontSize="11"
                            Padding="12,6" CornerRadius="4"
                            Command="{Binding CancelRunCommand}"
                            IsEnabled="{Binding IsRunning}"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,Auto,*">
                    <Button Grid.Column="0" Content="TX PARAMS" FontSize="10" FontWeight="SemiBold"
                            Background="#1E1E2E" Foreground="#19D7E5" Padding="10,4" CornerRadius="3" Margin="0,0,6,0"
                            Command="{Binding ToggleTxParamsCommand}"
                            ToolTip.Tip="from / to / value / calldata / gas price"/>
                    <Button Grid.Column="1" Content="BLOCK CONTEXT" FontSize="10" FontWeight="SemiBold"
                            Background="#1E1E2E" Foreground="#19D7E5" Padding="10,4" CornerRadius="3"
                            Command="{Binding ToggleBlockContextCommand}"/>
                    <Border Grid.Column="2" Background="#12131A" CornerRadius="3" Padding="10,4" Margin="8,0,0,0"
                            BorderBrush="#2D2D4D" BorderThickness="1">
                        <TextBlock Text="{Binding ResultBanner}" Foreground="{Binding ResultBannerColor}"
                                   FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    </Border>
                </Grid>

                <Border Background="#161824" BorderBrush="#2D2D4D" BorderThickness="1" CornerRadius="4" Padding="10,6"
                        IsVisible="{Binding IsTxParamsExpanded}">
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto,*,Auto,*">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="From:" Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,4"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TxFrom}" Background="#0D0D0D" Foreground="#19D7E5"
                                 FontFamily="Consolas" FontSize="10" Padding="6,2" Margin="0,0,12,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="To (code):" Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,4"/>
                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding TxTo}" Background="#0D0D0D" Foreground="#FFD700"
                                 FontFamily="Consolas" FontSize="10" Padding="6,2" Margin="0,0,12,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Value wei:" Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,4"/>
                        <TextBox Grid.Row="0" Grid.Column="5" Text="{Binding TxValueWei}" Background="#0D0D0D" Foreground="#F0F4F8"
                                 FontFamily="Consolas" FontSize="10" Padding="6,2" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Calldata:" Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding CallDataHex}"
                                 Watermark="0x… optional call data"
                                 Background="#0D0D0D" Foreground="#F0F4F8" FontFamily="Consolas" FontSize="10" Padding="6,2" Margin="0,0,12,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="4" Text="GasPrice gwei:" Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding GasPriceGwei}" Background="#0D0D0D" Foreground="#19D7E5"
                                 FontFamily="Consolas" FontSize="10" Padding="6,2"/>
                    </Grid>
                </Border>

                <Border Background="#161824" BorderBrush="#2D2D4D" BorderThickness="1" CornerRadius="4" Padding="10,6"
                        IsVisible="{Binding IsBlockContextExpanded}">
                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*,Auto,*">
                        <TextBlock Grid.Column="0" Text="Tx Gas:" Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="1" Text="{Binding TxGasLimit}" Background="#0D0D0D" Foreground="#19D7E5" FontSize="11" Padding="6,2" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="2" Text="Block Gas:" Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="3" Text="{Binding BlockGasLimit}" Background="#0D0D0D" Foreground="#E0E0E0" FontSize="11" Padding="6,2" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="4" Text="BaseFee Gwei:" Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="5" Text="{Binding BaseFeeGwei}" Background="#0D0D0D" Foreground="#19D7E5" FontSize="11" Padding="6,2" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="6" Text="ChainId:" Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="7" Text="{Binding ChainId}" Background="#0D0D0D" Foreground="#E0E0E0" FontSize="11" Padding="6,2" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="8" Text="Coinbase:" Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="9" Text="{Binding CoinbaseAddress}" Background="#0D0D0D" Foreground="#FFAA00" FontSize="10" FontFamily="Consolas" Padding="6,2"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- MAIN -->
        <Grid Grid.Row="4" ColumnDefinitions="220,*,300" Margin="8,8,8,0">
            <!-- Explorer -->
            <Border Grid.Column="0" Classes="panel">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="12,12,12,0">
                        <TextBlock Grid.Column="0" Text="EXPLORER" Classes="header" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Open" Padding="6,2" FontSize="11" Background="#1E1E2E" CornerRadius="3" Margin="0,0,4,0"
                                Click="OnOpenFileClick"/>
                        <Button Grid.Column="2" Content="Folder" Padding="6,2" FontSize="11" Background="#1E1E2E" CornerRadius="3"
                                Click="OnOpenFolderClick"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1">
                        <StackPanel Margin="12,8">
                            <TextBox Watermark="Search files or code..."
                                     Text="{Binding SearchQuery}"
                                     Background="#0D0D0D" BorderBrush="#2D2D2D"
                                     Foreground="#E0E0E0" Padding="8,6" Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding FilteredProjectFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ProjectFileViewModel">
                                        <Border Background="{Binding IsSelected, Converter={x:Static vm:BoolToColorConverter.Instance}}"
                                                Padding="8,6" Margin="0,2" CornerRadius="3"
                                                PointerPressed="OnFileClick" Cursor="Hand">
                                            <TextBlock Text="{Binding FileName}" Foreground="#E0E0E0" FontSize="12"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No open files" Foreground="#666" FontSize="11" Margin="0,8,0,0"
                                       IsVisible="{Binding !HasOpenFiles}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Center: source / empty / call graph -->
            <Border Grid.Column="1" Classes="panel" Margin="4,0,4,0">
                <Grid>
                    <!-- Source (when not call graph) -->
                    <Grid IsVisible="{Binding !IsCallGraphVisible}">
                        <!-- Full brand mark as soft watermark — sits behind code, never steals clicks -->
                        <Image Source="/Assets/scrutor-watermark.png"
                               Width="300" Height="300"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="{Binding WatermarkOpacity}"
                               IsHitTestVisible="False"/>

                        <!-- Code on top of watermark -->
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding ActiveCodeLines}" Margin="12,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CodeLineViewModel">
                                        <Grid ColumnDefinitions="20,40,*" Margin="0,0,0,2">
                                            <TextBlock Grid.Column="0" Text=">" Foreground="#19D7E5" FontWeight="Bold" FontSize="11"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       IsVisible="{Binding IsActiveLine}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding LineNumber}" Classes="linenumber" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Padding="8,2" CornerRadius="2"
                                                    Classes.activeLine="{Binding IsActiveLine}"
                                                    Classes.vulnerableLine="{Binding IsVulnerableLine}">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding Text}" Classes="code" TextWrapping="NoWrap"/>
                                                    <Border Grid.Column="1" Background="#1E143B" BorderBrush="#19D7E5" BorderThickness="1"
                                                            CornerRadius="3" Padding="6,1" Margin="6,0"
                                                            IsVisible="{Binding HasGasBadge}">
                                                        <TextBlock Text="{Binding GasBadgeText}" Foreground="#19D7E5" FontSize="10" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Empty-state hints only (logo is watermark, not a blocking overlay) -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                    Margin="0,0,0,28" Spacing="6"
                                    IsVisible="{Binding !HasOpenFiles}"
                                    IsHitTestVisible="False">
                            <TextBlock Text="Precise · Verifiable · Traceable · Conformant"
                                       Foreground="#A9A9A9" FontSize="12" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding CenterEmptyHint}" Foreground="#19D7E5" FontSize="12"
                                       TextWrapping="Wrap" MaxWidth="380" TextAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Call graph -->
                    <Grid IsVisible="{Binding IsCallGraphVisible}" RowDefinitions="Auto,*">
                        <Border Background="#141414" Padding="12,6" BorderBrush="#2D2D2D" BorderThickness="0,0,0,1">
                            <TextBlock Text="{Binding CallTopology.EmptyHint}" Foreground="#FFAA00" FontWeight="Bold" FontSize="12"/>
                        </Border>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Canvas Width="900" Height="600" Background="#0D0D0D">
                                <ItemsControl ItemsSource="{Binding CallTopology.Nodes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <!-- Position the item containers on the canvas -->
                                    <ItemsControl.Styles>
                                        <Style Selector="ContentPresenter" x:DataType="vm:CallNodeViewModel">
                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                        </Style>
                                    </ItemsControl.Styles>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CallNodeViewModel">
                                            <Border Background="#1E1E2E" BorderBrush="{Binding Color}" BorderThickness="2"
                                                    Padding="12,8" CornerRadius="8" MinWidth="120">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="{Binding Color}" FontWeight="Bold" FontSize="13"/>
                                                    <TextBlock Text="{Binding Address}" Foreground="#888" FontSize="10"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <!-- Inspector -->
            <Border Grid.Column="2" Classes="panel">
                <ScrollViewer>
                    <StackPanel Margin="12">
                        <TextBlock Text="EVM INSPECTOR" Classes="header"/>

                        <TextBlock Text="STEP (F10 / F11 / Space)" Foreground="#888" FontSize="10" Margin="0,8,0,4"/>
                        <Grid>
                            <TextBlock Text="{Binding StepProgress}" Foreground="#19D7E5" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Text="{Binding StepPercentage}" Foreground="#888" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider Minimum="0" Maximum="{Binding MaxStepIndex}" Value="{Binding CurrentStepIndex}"
                                IsEnabled="{Binding HasTrace}" Margin="0,6,0,0"/>
                        <Grid ColumnDefinitions="*,*,*,*,*" Margin="0,8,0,0">
                            <Button Grid.Column="0" Content="|◀" Height="28" Command="{Binding JumpToStartCommand}"
                                    Background="#1E1E2E" Foreground="#19D7E5" FontWeight="Bold"/>
                            <Button Grid.Column="1" Content="◀" Height="28" Command="{Binding StepBackCommand}"
                                    Background="#1E1E2E" Foreground="#19D7E5" FontWeight="Bold"/>
                            <Button Grid.Column="2"
                                    Content="{Binding IsAutoPlaying, Converter={x:Static vm:BoolToPlayLabelConverter.Instance}}"
                                    Height="28" Command="{Binding ToggleAutoPlayCommand}"
                                    Background="#4A00E0" Foreground="White" FontWeight="Bold"/>
                            <Button Grid.Column="3" Content="▶" Height="28" Command="{Binding StepForwardCommand}"
                                    Background="#1E1E2E" Foreground="#19D7E5" FontWeight="Bold"/>
                            <Button Grid.Column="4" Content="▶|" Height="28" Command="{Binding JumpToEndCommand}"
                                    Background="#1E1E2E" Foreground="#19D7E5" FontWeight="Bold"/>
                        </Grid>

                        <Border Background="#12131A" BorderBrush="#2D2D4D" BorderThickness="1" CornerRadius="4" Margin="0,12,0,0" Padding="10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="OPCODE NOTES (reference)" Foreground="#FFD700" FontWeight="Bold" FontSize="10"/>
                                <TextBlock Text="{Binding CurrentOpcodeSpec}" Foreground="#19D7E5" FontSize="11" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding CurrentGasFormulaBreakdown}" Foreground="#E0E0E0" FontSize="10" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding CurrentStepDetail}" Foreground="#888888" FontSize="10"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="RETURN DATA" Foreground="#888" FontSize="10" Margin="0,16,0,4"/>
                        <TextBox Text="{Binding ReturnDataHex}" IsReadOnly="True"
                                 Background="#0D0D0D" Foreground="#00D4AA" FontFamily="Consolas" FontSize="10"
                                 TextWrapping="Wrap" MaxHeight="64" AcceptsReturn="True"/>
                        <TextBlock Text="{Binding ErrorText}" Foreground="#FF4500" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"
                                   IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                        <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,4">
                            <TextBlock Grid.Column="0" Text="DISASSEMBLY (click step)" Foreground="#888" FontSize="10" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <TextBox Width="64" Text="{Binding PcSearch}" Watermark="PC"
                                         Background="#0D0D0D" Foreground="#19D7E5" FontFamily="Consolas" FontSize="10" Padding="4,2"/>
                                <Button Content="GO" FontSize="10" Padding="8,2" Command="{Binding JumpToPcCommand}"
                                        Background="#1E1E2E" Foreground="#19D7E5"/>
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Instructions}" MaxHeight="180">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:InstructionViewModel">
                                    <Border Padding="6,2" Margin="0,1" CornerRadius="2" Cursor="Hand"
                                            Background="{Binding IsActive, Converter={x:Static vm:BoolToColorConverter.Instance}}"
                                            PointerPressed="OnInstructionClick">
                                        <TextBlock Text="{Binding DisplayText}" FontFamily="Consolas" FontSize="10"
                                                   Foreground="{Binding IsActive, Converter={x:Static vm:BoolToFGConverter.Instance}}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="STACK" Foreground="#888" FontSize="10" Margin="0,16,0,4"/>
                        <ItemsControl ItemsSource="{Binding StackRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0D0D0D" Padding="8,4" Margin="0,1" CornerRadius="2">
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" Foreground="#19D7E5"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="MEMORY" Foreground="#888" FontSize="10" Margin="0,16,0,4"/>
                        <ItemsControl ItemsSource="{Binding MemoryRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0D0D0D" Padding="8,4" Margin="0,1" CornerRadius="2">
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="10" Foreground="#E0E0E0"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="STORAGE" Foreground="#888" FontSize="10" Margin="0,16,0,4"/>
                        <ItemsControl ItemsSource="{Binding StorageRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0D0D0D" Padding="8,4" Margin="0,1" CornerRadius="2">
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="10" Foreground="#FFD700"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="ACCOUNTS (post-run)" Foreground="#888" FontSize="10" Margin="0,16,0,4"/>
                        <ItemsControl ItemsSource="{Binding AccountStateRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="10" Foreground="#A9A9A9"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="LOGS" Foreground="#888" FontSize="10" Margin="0,16,0,4"/>
                        <ItemsControl ItemsSource="{Binding EventLogRows}" MaxHeight="100">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0D0D0D" Padding="6,3" Margin="0,1" CornerRadius="2">
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="9" Foreground="#F0F4F8" TextWrapping="Wrap"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="GAS" Foreground="#888" FontSize="10" Margin="0,16,0,4"/>
                        <ItemsControl ItemsSource="{Binding GasTreeNodes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:GasNodeViewModel">
                                    <TextBlock Text="{Binding DisplayText}" FontFamily="Consolas" FontSize="11"
                                               Foreground="{Binding Color}" Margin="{Binding Indent}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- FINDINGS -->
        <Border Grid.Row="5" Background="#141414" BorderBrush="#2D2D2D" BorderThickness="0,1,0,0" MinHeight="48" MaxHeight="140">
            <Grid RowDefinitions="Auto,*" Margin="16,8">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="SECURITY FINDINGS" Classes="header" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="EXPORT TRACE" Margin="0,0,6,0"
                            Background="#1E1E2E" Foreground="#FFD700" FontWeight="Bold" FontSize="10"
                            Padding="10,4" CornerRadius="3" Click="OnExportTraceClick"/>
                    <Button Grid.Column="2" Content="EXPORT AUDIT (.MD)"
                            Background="#1E1E2E" Foreground="#19D7E5" FontWeight="Bold" FontSize="10"
                            Padding="10,4" CornerRadius="3" Click="OnExportReportClick"/>
                </Grid>
                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding SecurityFindings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SecurityFindingViewModel">
                                <Border Background="#1E1E2E" Padding="12,8" Margin="0,0,0,4" CornerRadius="3">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding SeverityEmoji}" FontSize="14" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Description}" Foreground="#E0E0E0" FontSize="12"/>
                                            <TextBlock Text="{Binding Details}" Foreground="#888" FontSize="10" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="JUMP" Background="#4A00E0" Foreground="#0D0D0D"
                                                FontWeight="Bold" FontSize="11" Padding="12,6" CornerRadius="3"
                                                Command="{Binding #root.DataContext.JumpToFindingCommand}"
                                                CommandParameter="{Binding}"
                                                x:CompileBindings="False"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- STATUS -->
        <Border Grid.Row="6" Background="#0C0D14" BorderBrush="#2D2D3D" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#A0A0B0" FontSize="11" TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>
