<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Scrutor.UI.ViewModels"
        x:Class="Scrutor.UI.Views.MainWindow"
        x:DataType="vm:WorkbenchViewModel"
        Title="SCRUTOR — .NET 8 Ethereum Execution &amp; Verification Engine"
        WindowState="Maximized"
        Background="#0D0D0D"
        FontFamily="Consolas, Menlo, monospace">

    <Window.Styles>
        <Style Selector="TextBlock.header">
            <Setter Property="Foreground" Value="#19D7E5"/>
            <Setter Property="FontFamily" Value="Montserrat, Arial, sans-serif"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#1A1A2E"/>
            <Setter Property="BorderBrush" Value="#2D2D2D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="TextBlock.code">
            <Setter Property="FontFamily" Value="Consolas, Menlo, monospace"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
        </Style>
        <Style Selector="TextBlock.linenumber">
            <Setter Property="Foreground" Value="#19D7E5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Montserrat, Arial, sans-serif"/>
        </Style>

        <Style Selector="Border.activeLine">
            <Setter Property="Background" Value="#241B47"/>
            <Setter Property="BorderBrush" Value="#19D7E5"/>
            <Setter Property="BorderThickness" Value="2,0,0,0"/>
        </Style>

        <Style Selector="Border.vulnerableLine">
            <Setter Property="Background" Value="#2E141B"/>
            <Setter Property="BorderBrush" Value="#FF4500"/>
            <Setter Property="BorderThickness" Value="2,0,0,0"/>
        </Style>

        <Style Selector="Border.vulnerability-badge">
            <Setter Property="Background" Value="#3D1414"/>
            <Setter Property="BorderBrush" Value="#FF4500"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,2"/>
            <Style.Animations>
                <Animation Duration="0:0:1.0" IterationCount="Infinite" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1.0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.3"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Button.file-tab">
            <Setter Property="Background" Value="#16171D"/>
            <Setter Property="Foreground" Value="#A9A9A9"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="CornerRadius" Value="4,4,0,0"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
        </Style>

        <Style Selector="Button.file-tab-selected">
            <Setter Property="Background" Value="#241B47"/>
            <Setter Property="Foreground" Value="#19D7E5"/>
            <Setter Property="FontFamily" Value="Montserrat, Arial, sans-serif"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="CornerRadius" Value="4,4,0,0"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
        </Style>

        <Style Selector="TextBox.dark">
            <Setter Property="Background" Value="#1A1C23"/>
            <Setter Property="Foreground" Value="#F0F4F8"/>
            <Setter Property="BorderBrush" Value="#4A00E0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="#141414" Padding="16,10" BorderBrush="#2D2D2D" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Logo -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="⚡ SCRUTOR IDE" FontWeight="Bold" FontSize="18" Foreground="#19D7E5"/>
                    <TextBlock Text="EVM Security Platform" FontSize="13" Foreground="#888" VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Center: Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                    <TextBlock Text="{Binding CurrentFileTitle}" Foreground="#888" FontSize="12"/>
                </StackPanel>
                
                <!-- Right Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Border Background="#1E1E2E" Padding="10,4" CornerRadius="3">
                        <TextBlock Text="[CANCUN]" Foreground="#19D7E5" FontSize="11"/>
                    </Border>
                    <Border Background="#1E1E2E" Padding="10,4" CornerRadius="3">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🔒" FontSize="11"/>
                            <TextBlock Text="OPSEC: OFFLINE" Foreground="#19D7E5" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <Button Content="▶ RUN ANALYSIS" Background="#4A00E0" Foreground="#0D0D0D" 
                            FontWeight="Bold" Padding="16,6" CornerRadius="4" FontSize="12"
                            Command="{Binding RunTransactionCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
        
        
        <!-- FILE TABS -->
        <Border Grid.Row="1" Background="#141414" Padding="16,6" BorderBrush="#2D2D2D" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="0">
                <ItemsControl ItemsSource="{Binding ProjectFiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="0"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProjectFileViewModel">
                            <Border Padding="12,6" CornerRadius="4,4,0,0" 
                                    Background="{Binding IsSelected, Converter={x:Static vm:BoolToColorConverter.Instance}}"
                                    PointerPressed="OnTabClick"
                                    Cursor="Hand">
                                <TextBlock Text="{Binding FileName}" 
                                           Foreground="{Binding IsSelected, Converter={x:Static vm:BoolToFGConverter.Instance}}"
                                           FontWeight="{Binding IsSelected, Converter={x:Static vm:BoolToFontWeightConverter.Instance}}"
                                           FontSize="12"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <!-- Separator -->
                <Border Width="1" Height="16" Background="#2D2D2D" Margin="12,0,12,0" VerticalAlignment="Center"/>
                
                <!-- Call Graph Tab -->
                <Border Padding="12,6" CornerRadius="4,4,0,0" Background="#1E1E2E"
                        PointerPressed="OnCallGraphClick" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="📊" FontSize="12"/>
                        <TextBlock Text="CALL GRAPH" Foreground="#FFAA00" FontWeight="Bold" FontSize="12"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="2" ColumnDefinitions="220,*,280" Margin="8,8,8,8">
            
            <!-- LEFT: PROJECT EXPLORER -->
            <Border Grid.Column="0" Classes="panel">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Text="PROJECT EXPLORER" Classes="header" Margin="12,12,12,0"/>
                    
                    <ScrollViewer Grid.Row="1">
                        <StackPanel Margin="12,8">
                            <TextBox Watermark="🔍 Search code..." 
                                     Text="{Binding SearchQuery}"
                                     Background="#0D0D0D" BorderBrush="#2D2D2D" 
                                     Foreground="#E0E0E0" Padding="8,6" Margin="0,0,0,12"/>
                            
                            <ItemsControl ItemsSource="{Binding ProjectFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ProjectFileViewModel">
                                        <Border Background="#0D0D0D" Padding="8,6" Margin="0,2" CornerRadius="3"
                                                PointerPressed="OnFileClick">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="📄" FontSize="12"/>
                                                <TextBlock Text="{Binding FileName}" Foreground="#E0E0E0" FontSize="12"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- CENTER: SOURCE CODE EDITOR -->
            <Border Grid.Column="1" Classes="panel" Margin="4,0,4,0"
                    IsVisible="{Binding !IsCallGraphVisible}">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding ActiveCodeLines}" Margin="12,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CodeLineViewModel">
                                <Grid ColumnDefinitions="20,40,*" Margin="0,0,0,2">
                                    <!-- Active Line Cursor -->
                                    <TextBlock Grid.Column="0" Text="▶" 
                                               Foreground="#19D7E5" FontWeight="Bold" FontSize="11"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsVisible="{Binding IsActiveLine}"/>
                                    
                                    <!-- Line Number -->
                                    <TextBlock Grid.Column="1" Text="{Binding LineNumber}" Classes="linenumber" VerticalAlignment="Center"/>
                                    
                                    <!-- Code Line -->
                                    <Border Grid.Column="2" Padding="8,2" CornerRadius="2"
                                            Classes.activeLine="{Binding IsActiveLine}"
                                            Classes.vulnerableLine="{Binding IsVulnerableLine}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Text}" Classes="code" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                                            
                                            <!-- Pulsing Vulnerability Marker -->
                                            <Border Grid.Column="1" Classes="vulnerability-badge" IsVisible="{Binding IsVulnerableLine}">
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="🔴" FontSize="10" VerticalAlignment="Center"/>
                                                    <TextBlock Text="REENTRANCY VULNERABILITY" Foreground="#FF4500" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>


            <!-- CALL GRAPH PANEL -->
            <Border Grid.Column="1" Classes="panel" Margin="4,0,4,0"
                    IsVisible="{Binding IsCallGraphVisible}">
                <Grid RowDefinitions="Auto,*">
                    <Border Background="#141414" Padding="12,6" BorderBrush="#2D2D2D" BorderThickness="0,0,0,1">
                        <TextBlock Text="📊 Live Call Topology" Foreground="#FFAA00" FontWeight="Bold" FontSize="12"/>
                    </Border>
                    
                    <Canvas Grid.Row="1" Background="#0D0D0D">
                        <!-- Title -->
                        <TextBlock Canvas.Left="200" Canvas.Top="20" Text="Inter-Contract Call Flow" 
                                   Foreground="#FFAA00" FontSize="14" FontWeight="Bold"/>
                        
                        <!-- Dynamic Nodes -->
                        <ItemsControl ItemsSource="{Binding CallTopology.Nodes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CallNodeViewModel">
                                    <Border Background="#1E1E2E" BorderBrush="{Binding Color}" BorderThickness="2" 
                                            Padding="16,10" CornerRadius="8" MinWidth="120">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Foreground="{Binding Color}" FontWeight="Bold" FontSize="14"/>
                                            <TextBlock Text="{Binding Address}" Foreground="#888" FontSize="10"/>
                                            <Border Background="#3A1A1A" Padding="4,2" CornerRadius="2" Margin="0,4,0,0"
                                                    IsVisible="{Binding HasVulnerability}">
                                                <TextBlock Text="🔴 VULNERABLE" Foreground="#FF4500" FontSize="9" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <!-- Legend -->
                        <Border Canvas.Left="50" Canvas.Top="400" Background="#1E1E2E" Padding="16,12" CornerRadius="6" BorderBrush="#2D2D2D" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="LEGEND:" Foreground="#888" FontSize="11" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,2">
                                    <Border Width="14" Height="14" Background="#FF4500" CornerRadius="3"/>
                                    <TextBlock Text="Attacker (External)" Foreground="#888" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,2">
                                    <Border Width="14" Height="14" Background="#4A00E0" CornerRadius="3"/>
                                    <TextBlock Text="Victim (Vulnerable)" Foreground="#888" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,2">
                                    <Border Width="14" Height="14" Background="#FFAA00" CornerRadius="3"/>
                                    <TextBlock Text="Intermediate Contract" Foreground="#888" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Canvas>
                </Grid>
            </Border>

        <!-- RIGHT: EVM INSPECTOR DRAWER -->
            <Border Grid.Column="2" Classes="panel">
                <ScrollViewer>
                    <StackPanel Margin="12">
                        <TextBlock Text="⚙ EVM INSPECTOR" Classes="header"/>
                        
                        <!-- Step Scrubber -->
                        <TextBlock Text="STEP SCRUBBER" Foreground="#888" FontSize="10" Margin="0,8,0,4"/>
                        <Grid>
                            <TextBlock Text="{Binding StepProgress}" Foreground="#19D7E5" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Text="{Binding StepPercentage}" Foreground="#888" FontSize="11" 
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,8,0,0">
                            <Button Content="|◀" Width="36" Height="28" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    Background="#1E1E2E" Foreground="#19D7E5" FontWeight="Bold" CornerRadius="3" Cursor="Hand"
                                    Command="{Binding JumpToStartCommand}" ToolTip.Tip="Jump to Start"/>
                            <Button Content="◀" Width="36" Height="28" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    Background="#1E1E2E" Foreground="#19D7E5" FontWeight="Bold" CornerRadius="3" Cursor="Hand"
                                    Command="{Binding StepBackCommand}" ToolTip.Tip="Step Back"/>
                            <Button Content="▶" Width="36" Height="28" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    Background="#1E1E2E" Foreground="#19D7E5" FontWeight="Bold" CornerRadius="3" Cursor="Hand"
                                    Command="{Binding StepForwardCommand}" ToolTip.Tip="Step Forward"/>
                            <Button Content="▶|" Width="36" Height="28" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    Background="#1E1E2E" Foreground="#19D7E5" FontWeight="Bold" CornerRadius="3" Cursor="Hand"
                                    Command="{Binding JumpToEndCommand}" ToolTip.Tip="Jump to End"/>
                        </StackPanel>
                        
                        <!-- Stack -->
                        <TextBlock Text="STACK" Foreground="#888" FontSize="10" Margin="0,16,0,4"/>
                        <ItemsControl ItemsSource="{Binding StackRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0D0D0D" Padding="8,4" Margin="0,1" CornerRadius="2">
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" Foreground="#19D7E5"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <!-- Memory -->
                        <TextBlock Text="MEMORY" Foreground="#888" FontSize="10" Margin="0,16,0,4"/>
                        <ItemsControl ItemsSource="{Binding MemoryRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0D0D0D" Padding="8,4" Margin="0,1" CornerRadius="2">
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="10" Foreground="#E0E0E0"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <!-- Gas Tree -->
                        <TextBlock Text="GAS TREE" Foreground="#888" FontSize="10" Margin="0,16,0,4"/>
                        <ItemsControl ItemsSource="{Binding GasTreeNodes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:GasNodeViewModel">
                                    <TextBlock Text="{Binding DisplayText}" 
                                               FontFamily="Consolas" FontSize="11"
                                               Foreground="{Binding Color}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- BOTTOM: SECURITY FINDINGS -->
        <Border Grid.Row="2" VerticalAlignment="Bottom" Background="#141414" 
                BorderBrush="#2D2D2D" BorderThickness="0,1,0,0" MaxHeight="160" Margin="0,0,0,0">
            <Grid RowDefinitions="Auto,*" Margin="16,8">
                <TextBlock Text="⚠ SECURITY FINDINGS" Classes="header"/>
                
                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding SecurityFindings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SecurityFindingViewModel">
                                <Border Background="#1E1E2E" Padding="12,8" Margin="0,0,0,4" CornerRadius="3">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding SeverityEmoji}" 
                                                   FontWeight="Bold" FontSize="14" Margin="0,0,12,0"/>
                                        
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Description}" Foreground="#E0E0E0" FontSize="12"/>
                                            <TextBlock Text="{Binding Details}" Foreground="#888" FontSize="10" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        
                                        <Button Grid.Column="2" Content="JUMP TO CODE ➔" 
                                                Background="#4A00E0" Foreground="#0D0D0D"
                                                FontWeight="Bold" FontSize="11" Padding="12,6" CornerRadius="3"
                                                Command="{Binding #root.DataContext.JumpToFindingCommand}" 
                                                CommandParameter="{Binding}"
                                                x:CompileBindings="False"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
